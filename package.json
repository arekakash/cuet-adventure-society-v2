{
  "name": "cuet-adventure-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for CUET Adventure Society — events, store, blood bank, My Bangladesh explorer, and Campfire AI.",
  "author": "CUET Adventure Society",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules/.cache",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:preview": "npm run pages:build && wrangler pages dev .vercel/output/static --compatibility-date=2024-09-23 --compatibility-flag=nodejs_compat",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "next": "^14.2.18",
    "prop-types": "^15.8.1",
    "quill": "^1.3.7",
    "react": "^18.3.1",
    "react-cropper": "^2.3.3",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.0.8",
    "react-quill": "^2.0.0",
    "react-simple-maps": "^3.0.0",
    "tailwind-merge": "^2.5.4",
    "topojson-client": "^3.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vercel": "^37.14.0",
    "wrangler": "^3.80.0"
  }
